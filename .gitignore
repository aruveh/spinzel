# ==========================================
# WordPress Core Files
# ==========================================
# It is best practice to keep core files out of Git.
# If you need to track them, comment out this section.
/wp/wp-admin/
/wp/wp-includes/
/wp/index.php
/wp/license.txt
/wp/readme.html
/wp/wp-*.php
/wp/xmlrpc.php

# ==========================================
# WordPress Configuration & Server Files
# ==========================================
# NEVER commit database credentials or environment variables.
/wp/wp-config.php
/wp/wp-config-sample.php
/wp/.htaccess
/wp/nginx.conf
/wp/*.log
.env
.env.*

# ==========================================
# Content Directory (wp-content)
# ==========================================
# Ignore the index files WordPress puts in folders to prevent directory browsing
/wp/wp-content/index.php
/wp/wp-content/plugins/index.php
/wp/wp-content/themes/index.php

# Ignore user media uploads (they belong in cloud storage, backups, or local assets)
/wp/wp-content/uploads/
/wp/wp-content/blogs.dir/
/wp/wp-content/upgrade/
/wp/wp-content/backup-*

# Ignore core translation files downloaded automatically
/wp/wp-content/languages/

# ==========================================
# Plugins & Themes
# ==========================================
# Option A: Ignore third-party items but track custom work (Recommended)
# Step 1: Ignore all themes and plugins by default
/wp/wp-content/themes/*
/wp/wp-content/plugins/*

# Step 2: Use an exclamation point (!) to whitelist your custom folders
!/wp/wp-content/themes/your-custom-theme-name/
!/wp/wp-content/plugins/your-custom-plugin-name/

# ==========================================
# Caching, Optimization, and Node Packages
# ==========================================
# Common caching plugin directories
/wp/wp-content/cache/
/wp/wp-content/wphb-cache/
/wp/wp-content/advanced-cache.php
/wp/wp-content/wp-cache-config.php

# Node and build artifacts if your custom theme uses a bundler (Vite, Webpack, etc.)
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# System & Editor Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln


/vendor/
/wp/

.env
*.code-workspace